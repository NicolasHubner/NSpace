AddDefaultCharset UTF-8

# Mode Rewrite
RewriteEngine On

# Página de Login
RewriteRule ^login/$ 						login.php

# Autenticação de usuário
RewriteRule ^authentication/$ 					authentication.php

# Logout
RewriteRule ^logout/$ 						logout.php

RewriteRule ^modulo-permissao/$ 						modulo_permissao.php

# Abertura de Páginas
RewriteRule ^([0-9a-z-_]+)/?$ 					index.php?model=$1&%{QUERY_STRING}
RewriteRule ^([0-9a-z-_]+)/([0-9a-z-_]+)/?$ 			index.php?model=$1&action=$2&%{QUERY_STRING}
RewriteRule ^([0-9a-z-_]+)/([0-9a-z-_]+)/([0-9-]+)/?$ 		index.php?model=$1&action=$2&id=$3&%{QUERY_STRING}

# Envio de formulários POST
RewriteRule ^action/([0-9a-z-_]+)/([0-9a-z-_]+)/?$ 		action.php?model=$1&action=$2&%{QUERY_STRING}
RewriteRule ^action/([0-9a-z-_]+)/([0-9a-z-_]+)/([0-9-]+)/?$ 	action.php?model=$1&action=$2&id=$3&%{QUERY_STRING}